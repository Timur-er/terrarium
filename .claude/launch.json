{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "terrarium",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "client",
        "run",
        "dev",
        "--",
        "--port",
        "5173",
        "--strictPort"
      ],
      "port": 5173
    },
    {
      "name": "brain",
      "runtimeExecutable": "brain/.venv/bin/uvicorn",
      "runtimeArgs": [
        "brain.server:app",
        "--port",
        "8765"
      ],
      "port": 8765
    },
    {
      "name": "world",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--prefix",
        "server",
        "tsx",
        "server/index.ts"
      ],
      "port": 8787
    }
  ]
}